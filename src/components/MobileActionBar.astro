---
/**
 * Mobile-only sticky action bar: Book + Call.
 * Appears after the hero, hides again when the contact section or footer is on screen,
 * so it never covers the form or duplicates visible CTAs.
 */
import { bookingPath, phoneHref } from '@/lib/contact';
import type { Translator } from '@/i18n/utils';

interface Props {
  t: Translator;
}

const { t } = Astro.props;
---

<div class="mab" data-mab>
  <a href={phoneHref(t.locale)} class="mab__btn mab__btn--ghost">
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
    {t('cta.call')}
  </a>
  <a href={bookingPath(t.locale)} class="mab__btn mab__btn--primary">{t('cta.book')}</a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mab]');
  if (bar) {
    let pastHero = false;
    const hidden = new Set<Element>();
    const update = () => bar.classList.toggle('is-visible', pastHero && hidden.size === 0);

    const onScroll = () => {
      pastHero = window.scrollY > window.innerHeight * 0.6;
      update();
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? hidden.add(e.target) : hidden.delete(e.target)));
      update();
    });
    document.querySelectorAll('#contact, footer').forEach((el) => io.observe(el));
  }
</script>

<style>
  .mab {
    position: fixed;
    inset: auto 0 0;
    z-index: var(--z-bar);
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 0.5rem;
    padding: 0.5rem var(--gutter) calc(0.5rem + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--color-anthracite) 96%, transparent);
    border-top: 1px solid var(--line);
    transform: translateY(100%);
    transition: transform var(--dur) var(--ease-out);
  }

  .mab.is-visible {
    transform: none;
  }

  .mab__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--tap);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
  }

  .mab__btn--ghost {
    border: 1px solid var(--line-strong);
    color: var(--text-strong);
  }

  .mab__btn--primary {
    background: var(--color-ivory);
    color: var(--color-graphite);
  }

  @media (min-width: 900px) {
    .mab {
      display: none;
    }
  }
</style>
