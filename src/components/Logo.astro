---
/**
 * Wordmark placeholder. Swap the inner markup for the real SVG logo when available.
 */
import type { Translator } from '@/i18n/utils';

interface Props {
  t: Translator;
  size?: 'md' | 'lg';
}

const { t, size = 'md' } = Astro.props;
---

<a href={t.path('/')} class:list={['logo', `logo--${size}`]} aria-label={t('a11y.home')}>
  <span class="logo__name">Havryluk</span>
  <span class="logo__sub">Clinic</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.7rem;
    min-height: var(--tap);
    align-items: center;
    color: var(--text-strong);
    white-space: nowrap;
  }

  .logo__name {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .logo__sub {
    padding-left: 0.7rem;
    border-left: 1px solid var(--line-strong);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-wordmark);
    text-transform: uppercase;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .logo--lg .logo__name {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .logo--lg .logo__sub {
    font-size: 0.7rem;
  }
</style>
