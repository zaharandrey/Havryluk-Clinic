---
/**
 * Hero — full-bleed photo (or optional muted video) with the H1 set in the lower-left.
 * Media slot accepts: doctor portrait, interior, lifestyle photo, or a short muted loop.
 * No "smiling mouth" stock imagery.
 */
import type { ImageMetadata } from 'astro';
import Media from './Media.astro';
import Button from './Button.astro';
import TrustBar from './TrustBar.astro';
import { bookingPath } from '@/lib/contact';
import type { Translator } from '@/i18n/utils';

interface Props {
  t: Translator;
  image?: ImageMetadata;
  /** Optional muted background loop (MP4/WebM, ≤ 2–3 MB, ~10 s). Skipped for reduced-motion users. */
  video?: { src: string; type?: string };
}

const { t, image, video } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <Media
      src={image}
      alt={t.locale === 'uk' ? 'Інтер’єр Havryluk Clinic' : 'Havryluk Clinic interior'}
      ratio="auto"
      tone="warm"
      label={t.locale === 'uk' ? 'Hero: портрет лікаря / інтер’єр / відео · 16:9' : 'Hero: doctor portrait / interior / video · 16:9'}
      sizes="100vw"
      priority
      class="hero__img"
    />
    {
      video && (
        <video class="hero__video" autoplay muted loop playsinline preload="none" aria-hidden="true">
          <source src={video.src} type={video.type ?? 'video/mp4'} />
        </video>
      )
    }
    <div class="hero__overlay" aria-hidden="true"></div>
  </div>

  <div class="hero__content container">
    <p class="eyebrow hero__eyebrow hero-in">
      <span class="hero__eyebrow-line" aria-hidden="true"></span>{t('hero.eyebrow')}
    </p>

    <h1 id="hero-title" class="hero__title hero-in" style="--d: 80ms">
      {t('hero.title.line1')}<br /><em>{t('hero.title.line2')}</em>
    </h1>

    <div class="hero__bottom">
      <p class="lead hero__lead hero-in" style="--d: 180ms">{t('hero.lead')}</p>
      <div class="hero__ctas hero-in" style="--d: 260ms">
        <Button href={bookingPath(t.locale)} arrow>{t('cta.bookConsultation')}</Button>
        <Button href={t.path('/#services')} variant="outline">{t('cta.services')}</Button>
      </div>
    </div>
  </div>

  <TrustBar t={t} />
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    background: var(--surface-base);
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media :global(.hero__img) {
    height: 100%;
  }

  /* Corner marks would collide with the header */
  .hero__media :global(.media--placeholder)::after {
    display: none;
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--overlay-hero);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + var(--space-xl));
    padding-bottom: clamp(2.5rem, 2rem + 3vw, 5rem);
  }

  .hero__eyebrow {
    margin-bottom: var(--space-md);
  }

  .hero__eyebrow-line {
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--line-accent);
  }

  .hero__title {
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    max-width: 20ch;
  }

  .hero__bottom {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  .hero__lead {
    color: var(--text);
    opacity: 0.86;
    max-width: 34rem;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 479px) {
    .hero__ctas :global(.btn) {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 1100px) {
    .hero__bottom {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: var(--space-xl);
    }
  }
</style>
